# Copy this file to .env and fill in the values
# Ask your team lead for OPENROUTER_API_KEY

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite (default, no setup needed)
DATABASE_URL=sqlite:///data/webapp.db
# Production (Postgres on GCP):
# DATABASE_URL=postgresql://qong:password@localhost:5432/qong

# ── Redis / Job Queue ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Production (Tailscale IP of GCP VM):
# REDIS_URL=redis://:yourpassword@100.x.y.z:6379/0

OPENROUTER_API_KEY=sk-or-your-key-here
SECRET_KEY=change-this-to-any-random-string
LS_API_KEY=                         # Set after Label Studio first run (see README Step 6)
LS_EXTERNAL_URL=http://localhost:9001

# ==== Storage (S3-compatible) ====
# Local dev (MinIO — start with: docker compose up minio minio-init)
STORAGE_ENDPOINT_URL=http://localhost:9100
STORAGE_BUCKET=qong-local
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
# Production (GCS interop) — uncomment + fill in for cloud
# STORAGE_ENDPOINT_URL=https://storage.googleapis.com
# STORAGE_BUCKET=qong-prod
# STORAGE_ACCESS_KEY=GOOG1...
# STORAGE_SECRET_KEY=...
