meta {
  name: TT - Advanced
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/instrument-match
  body: json
  auth: none
}

headers {
  X-API-KEY: {{api_key}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "instType": "TT",
    "range_min": -50,
    "range_max": 200,
    "range_unit": "C",
    "ids_input_signal": "RTD Pt100",
    "ids_output_signal": "4-20mA HART",
    "power_supply": "24VDC"
  }
}
