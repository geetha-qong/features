meta {
  name: TI - Advanced
  type: http
  seq: 9
}

post {
  url: {{base_url}}/api/instrument-match
  body: json
  auth: none
}

headers {
  X-API-KEY: {{api_key}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "instType": "TI",
    "range_min": -200,
    "range_max": 850,
    "range_unit": "C",
    "ids_input_signal": "RTD Pt100",
    "ids_output_signal": "4-20mA",
    "power_supply": "24VDC"
  }
}
