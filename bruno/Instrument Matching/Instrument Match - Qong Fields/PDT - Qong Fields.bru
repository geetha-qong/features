docs {
  # PDT - Qong Fields Verification

  Matches ROSEMOUNT 3051CD (Qong expected response reference record).

  Expected response:

  ```json
  {
    "product_id": 2,
    "vendor_profile_id": 5,
    "brand": "ROSEMOUNT",
    "model_number": "3051CD",
    "manufacturer": "ROSEMOUNT",
    "model": "3051CD",
    "piping_class": "Class 150",
    "calibration_range_min": -622.72,
    "calibration_range_max": 622.72,
    "calibration_range_unit": "mbar",
    "measuring_range_min": -622.72,
    "measuring_range_max": 622.72,
    "measuring_range_unit": "mbar",
    "external_power_supply": "Yes",
    "power_supply_input": "10.5-55VDC",
    "power_supply_output": "4-20mA",
    "io_output": "HART"
  }
  ```
}
