meta {
  name: FT - Flow Transmitter
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/instrument-match
  body: json
  auth: none
}

headers {
  X-API-KEY: {{api_key}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "instType": "FT"
  }
}

docs {
  # FT - Flow Transmitter

  New instrument type added to the resolver.
  Returns all flow transmitter products with Qong fields once data is seeded.
  Supports optional filter: accuracy.
}
