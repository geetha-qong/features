meta {
  name: PG - Pressure Gauge
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/instrument-match
  body: json
  auth: none
}

headers {
  X-API-KEY: {{api_key}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "instType": "PG",
    "range_min": 0,
    "range_max": 10,
    "range_unit": "bar"
  }
}
