meta {
  name: TI - Temperature Indicator
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/instrument-match
  body: json
  auth: none
}

headers {
  X-API-KEY: {{api_key}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "instType": "TI",
    "range_min": -200,
    "range_max": 850,
    "range_unit": "C"
  }
}
