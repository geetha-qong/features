meta {
  name: PDT - Differential Pressure Transmitter
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/instrument-match
  body: json
  auth: none
}

headers {
  X-API-KEY: {{api_key}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "instType": "PDT",
    "range_min": 0,
    "range_max": 500,
    "range_unit": "mbar"
  }
}
