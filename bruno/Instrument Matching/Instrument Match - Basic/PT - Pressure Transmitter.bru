meta {
  name: PT - Pressure Transmitter
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/instrument-match
  body: json
  auth: none
}

headers {
  X-API-KEY: {{api_key}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "instType": "PT",
    "range_min": 0,
    "range_max": 100,
    "range_unit": "bar"
  }
}
