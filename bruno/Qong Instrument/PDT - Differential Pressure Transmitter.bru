meta {
  name: PDT - Differential Pressure Transmitter
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/qong-instrument
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-API-KEY: {{api_key}}
}

body:json {
  {
    "instType": "PDT"
  }
}

docs {
  # PDT — Qong Instrument

  Returns the first active Differential Pressure Transmitter product.

  Expected response:

  ```json
  {
    "success": true,
    "instType": "PDT",
    "data": {
      "product_id": 1,
      "vendor_profile_id": 3,
      "vendor_name": "Vrushab Process Automation Pvt Ltd",
      "manufacturer": "ROSEMOUNT",
      "model_number": "3051CD",
      "piping_class": "ANSI150",
      "calibration_range_min": 4,
      "calibration_range_max": 20,
      "calibration_range_unit": "mA",
      "measuring_range_min": 0,
      "measuring_range_max": 250,
      "measuring_range_unit": "mbar",
      "external_power_supply": "Yes",
      "power_supply_input": "10.5-42.4VDC",
      "power_supply_output": null,
      "io_output": "4-20mA HART"
    }
  }
  ```
}
