meta {
  name: PT - Pressure Transmitter
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/qong-instrument
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-API-KEY: {{api_key}}
}

body:json {
  {
    "instType": "PT"
  }
}

docs {
  # PT — Qong Instrument

  Returns the first active Pressure Transmitter product.

  Expected response:

  ```json
  {
    "success": true,
    "instType": "PT",
    "data": {
      "product_id": 1,
      "vendor_profile_id": 1,
      "vendor_name": "Water Innovations India Pvt Ltd",
      "manufacturer": "SUPMEA",
      "model_number": "SUP-P300",
      "piping_class": "ANSI150",
      "calibration_range_min": 4,
      "calibration_range_max": 20,
      "calibration_range_unit": "mA",
      "measuring_range_min": 0,
      "measuring_range_max": 100,
      "measuring_range_unit": "bar",
      "external_power_supply": "Yes",
      "power_supply_input": "24VDC",
      "power_supply_output": null,
      "io_output": "4-20mA HART"
    }
  }
  ```
}
